{
  "name": "@rotating-msig/signer",
  "productName": "Keyturn",
  "version": "0.1.0",
  "private": true,
  "description": "rotation-signer: local web UI that confirms and executes Safe transactions with each signer's current rotation key.",
  "type": "module",
  "bin": {
    "rotation-signer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build ui",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json && tsc --noEmit -p desktop/tsconfig.json",
    "test": "node --conditions=source --import tsx --test test/*.test.ts desktop/*.test.ts",
    "start": "tsx --conditions=source src/cli.ts",
    "ui": "vite ui",
    "demo": "tsx --conditions=source scripts/local-demo.ts",
    "desktop:build": "npm run build -w @rotating-msig/core -w @rotating-msig/keys --prefix .. && tsc -p desktop/tsconfig.json && vite build ui",
    "desktop": "npm run desktop:build && electron ."
  },
  "dependencies": {
    "@rotating-msig/core": "0.1.0",
    "@rotating-msig/keys": "0.1.0",
    "@scure/bip39": "2.4.0",
    "viem": "2.56.8"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "ethers": "6.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "main": "dist-desktop/desktop/main.js"
}
